{
    "vocab_size": 50000,
    "hidden_size": 768,
    "num_layers": 16,
    "num_heads": 12,
    "intermediate_size": 2048,
    "max_seq_len": 512,
    "batch_size": 8,
    "learning_rate": 3e-4,
    "num_epochs": 3,
    "warmup_steps": 500,
    "gradient_accumulation_steps": 2,
    "max_grad_norm": 1.0,
    "weight_decay": 0.1,
    "save_steps": 500,
    "save_total_limit": 3,
    "logging_steps": 50,
    "log_dir": "./logs",
    "use_distributed": false,
    "use_fsdp": false,
    "sharding_strategy": "FULL_SHARD",
    "data_path": "./dataset",
    "tokenizer_path": "./tokenizer",
    "use_ram_cache": true,
    "max_new_tokens": 100,
    "temperature": 1.0,
    "top_k": 50,
    "top_p": 0.9
}